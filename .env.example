# Copy to .env and replace every deployment secret before a real deployment.
APP_ENV=development
SECRET_KEY=replace-this-with-a-unique-random-secret-of-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-strong-database-password
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# SMTP submission endpoint for verification, recovery and invitation email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# Backups are written to this directory and old files are pruned after 30 days.
ACADEX_BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
