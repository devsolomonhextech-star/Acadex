# Set this to the backend origin only. The app appends /api/v1.
# Android emulator: http://10.0.2.2:8001
# iOS simulator: http://127.0.0.1:8001
# Physical device: http://<your-development-computer-LAN-IP>:8001
EXPO_PUBLIC_API_URL=http://10.0.2.2:8001
# Set this after linking the app to an Expo EAS project (eas init).
EXPO_PUBLIC_EAS_PROJECT_ID=
