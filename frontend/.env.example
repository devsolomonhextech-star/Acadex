# Acadex frontend configuration (copy to .env.local and fill in).
# These values are compiled into the browser bundle; never put a secret here.

# Product analytics is off unless both values are set and a staff member
# explicitly allows analytics in the consent prompt.
# Public PostHog project token from your own project's settings.
VITE_POSTHOG_PROJECT_TOKEN=
# PostHog ingestion host, for example https://us.i.posthog.com or https://eu.i.posthog.com.
VITE_POSTHOG_HOST=
